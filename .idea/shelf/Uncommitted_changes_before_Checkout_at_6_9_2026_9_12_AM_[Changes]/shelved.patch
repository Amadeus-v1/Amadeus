    <div id=\"errorMessage\" class=\"error-message hidden\"></div>\r\n                    <div id=\"successMessage\" class=\"error-message hidden\" style=\"background-color: #10b981;\"></div>\r\n\r\n                    <!-- Scanner Toggle -->\r\n                    <div class=\"feature-section\" style=\"text-align: center;\">\r\n                        <button id=\"toggleCameraButton\" class=\"btn btn-primary btn-full\" style=\"padding: 20px; font-size: 1.1rem; margin-bottom: 12px;\">\r\n                            \uD83D\uDCF7 Open Camera Scanner\r\n                        </button>\r\n                        <p style=\"font-size: 0.85rem; color: var(--muted);\">Point your camera at a barcode to scan automatically</p>\r\n                    </div>\r\n\r\n                    <!-- Camera Viewport -->\r\n                    <div id=\"cameraSection\" class=\"feature-section hidden\" style=\"padding: 10px; position: relative;\">\r\n                        <div style=\"display: flex; justify-content: space-between; align-items: center; padding: 10px;\">\r\n                            <h3 style=\"margin: 0; font-size: 1rem;\">\uD83D\uDCF9 Live Scanner</h3>\r\n                            <button id=\"stopCameraButton\" class=\"btn btn-secondary\" style=\"padding: 4px 12px; font-size: 0.8rem; color: #ff4444; border-color: #ff4444;\">Close Camera</button>\r\n                        </div>\r\n                        <div id=\"interactive\" class=\"viewport\" style=\"height: 350px;\">\r\n                            <div class=\"scanner-laser\"></div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Manual Input (Always available as fallback) -->\r\n                    <div class=\"feature-section\">\r\n                        <h3 style=\"margin-bottom: 16px; font-size: 1rem;\">⌨\uFE0F Manual Search</h3>\r\n                        <div style=\"display: flex; gap: 12px;\">\r\n                            <input \r\n                  