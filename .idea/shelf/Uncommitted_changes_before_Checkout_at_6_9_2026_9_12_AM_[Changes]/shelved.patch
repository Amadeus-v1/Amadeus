+let cameraActive = false;
+
+async function startCamera() {
+    if (cameraActive) return;
+
+    const cameraSection = document.getElementById('cameraSection');
+    const scanStatus = document.getElementById('scanStatus');
+
+    if (scanStatus) scanStatus.textContent = "Initializing camera...";
+
+    Quagga.init({
+        inputStream: {
+            name: "Live",
+            type: "LiveStream",
+            target: document.querySelector('#interactive'),
+            constraints: {
+                facingMode: "environment",
+                aspectRatio: { min: 1, max: 2 }
+            },
+        },
+        decoder: {
+            readers: ["ean_reader", "ean_8_reader", "upc_reader", "upc_e_reader", "code_128_reader", "code_39_reader"]
+        },
+        locate: true,
+        frequency: 10
+    }, function(err) {
+        if (err) {
+            console.error(err);
+            if (scanStatus) scanStatus.textContent = "Error: " + err.message;
+            return;
+        }
+        Quagga.start();
+        cameraActive = true;
+        cameraSection.classList.remove('hidden');
+        if (scanStatus) scanStatus.textContent = "📷 Scanning... Center the barcode";
+    });
+
+    Quagga.onDetected(async (result) => {
+        const code = result.codeResult.code;
+        if (code) {
+            if (scanStatus) scanStatus.textContent = "✨ Barcode found: " + code;
+            stopCamera();
+            lookupBarcode(code);
+        }
+    });
+}
+
+function stopCamera() {
+    if (!cameraActive) return;
+    Quagga.stop();
+    cameraActive = false;
+    document.getElementById('cameraSection').classList.add('hidden');
+}
+
+async function lookupBarcode(barcode) {
+    const scanStatus = document.getElementById('scanStatus');
+    if (scanStatus) scanStatus.textContent = "🔍 Looking up " + barcode + "...";
+
+    try {
+        const response = await fetch(`${API_BASE_URL}/catalog/barcode`, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ barcode: barcode })
+        });
+
+        const data = await response.json();
+
+        if (response.ok && data.success) {
+            // Fill form with data
+            document.getElementById('itemTitle').value = data.title || '';
+            document.getElementById('itemArtistAuthor').value = data.artist || '';
+            document.getElementById('itemMediaType').value = data.mediaType || '';
+            document.getElementById('itemFormat').value = data.format || '';
+            document.getElementById('itemCoverUrl').value = data.coverUrl || '';
+
+            if (data.year) {
+                // Approximate date since we only have year
+                document.getElementById('itemReleaseDate').value = `${data.year}-01-01`;
+            }
+
+            updateCoverPreview();
+            if (scanStatus) scanStatus.textContent = "✅ Item found and loaded!";
+            showFormMessage('✓ Item details loaded from barcode', 'success', false);
+        } else {
+            if (scanStatus) scanStatus.textContent = "❌ Item not found. Please enter manually.";
+            showFormMessage('Barcode not found in database', 'error');
+        }
+    } catch (error) {
+        if (scanStatus) scanStatus.textContent = "❌ Error looking up barcode";
+        console.error('Error scanning barcode:', error);
+    }
